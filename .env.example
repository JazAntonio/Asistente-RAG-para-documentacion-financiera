# ==============================================
# PINECONE CONFIGURATION
# ==============================================
# Get your API key from: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here

# Cloud provider: aws, gcp, or azure
PINECONE_CLOUD=aws

# Region where your index is hosted (e.g., us-east-1, us-west-2)
PINECONE_REGION=us-east-1

# Name of your Pinecone index
PINECONE_INDEX_NAME=financial-docs

# ==============================================
# OPENAI CONFIGURATION
# ==============================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Model to use for text generation
# Options: gpt-5-nano, gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# Note: GPT-5 Nano only supports temperature=1
OPENAI_MODEL=gpt-5-nano

# Embedding model for vector search
# Options: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ==============================================
# RAG CONFIGURATION
# ==============================================
# Number of similar documents to retrieve
TOP_K=5

# Maximum tokens in LLM response
MAX_TOKENS=1000

# Temperature for response generation (0.0 - 2.0)
# Note: GPT-5 Nano only supports temperature=1
TEMPERATURE=1

# Text chunk size for document processing
CHUNK_SIZE=1000

# Overlap between chunks
CHUNK_OVERLAP=200

# ==============================================
# BACKEND CONFIGURATION
# ==============================================
# Backend server port
BACKEND_PORT=8080

# RAG service URL (internal Docker network for local, full URL for production)
RAG_SERVICE_URL=http://rag-service:8000

# Allowed CORS origins (comma-separated, optional for development)
# Example for production: ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-domain.com
ALLOWED_ORIGINS=

# ==============================================
# FRONTEND CONFIGURATION
# ==============================================
# Public API URL for frontend (accessible from browser)
# For local development: http://localhost:8080
# For production: Your Render backend URL (e.g., https://your-backend.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:8080

# ==============================================
# PRODUCTION DEPLOYMENT NOTES
# ==============================================
# When deploying to Vercel + Render:
#
# VERCEL (Frontend):
# - Set NEXT_PUBLIC_API_URL to your Render backend URL
#
# RENDER - Backend (Go):
# - Set RAG_SERVICE_URL to your RAG service URL (https://your-rag.onrender.com)
# - Set ALLOWED_ORIGINS to your Vercel URL (https://your-app.vercel.app)
#
# RENDER - RAG Service (Python):
# - Set PINECONE_API_KEY, OPENAI_API_KEY from your accounts
# - Keep other RAG configuration values as needed
